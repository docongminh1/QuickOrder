{
  "expo": {
    "name": "Cắt Liều Nhanh",
    "slug": "cat-lieu-nhanh",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.basebs.catlieunhanh"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F7B6C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.basebs.catlieunhanh",
      "versionCode": 8,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cắt Liều Nhanh dùng máy ảnh để chụp kệ thuốc và toa thuốc.",
          "photosPermission": "Cắt Liều Nhanh cần chọn ảnh kệ thuốc hoặc toa thuốc."
        }
      ],
      "expo-secure-store"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F7B6C"
    }
  }
}